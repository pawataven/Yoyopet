{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "types:supabase": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > shared/types/database.types.ts",
    "types:supabase:local": "supabase gen types typescript --db-url $SUPABASE_DB_URL --schema public > shared/types/database.types.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.153",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxtjs/supabase": "^2.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.14.0",
    "nuxt": "^4.6.4",
    "tailwindcss": "^4.3.5",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.14"
  }
}
